# SeqPass broker systemd unit (objective §8; corrected per §3.F deployment
# audit: directive placement, two-stage gate, complete topology arguments).
#
# Install:
#   sudo cp deploy/seqpass-broker.service /etc/systemd/system/
#   sudo cp /etc default template: see /etc/default/seqpass below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now seqpass-broker
#
# The unit runs the broker under a dedicated service identity with:
#   - restart on failure, bounded by the [Unit] StartLimit* window
#   - a two-stage gate:
#       stage 1 (ExecStartPre)  preflight: validates the expanded site
#                 configuration and the filesystem topology BEFORE the
#                 broker exists. It deliberately does NOT pass
#                 --require-verified: a preflight cannot prove the
#                 isolation of a broker that has not started, and doctor
#                 refuses to claim otherwise (it exits non-zero if asked).
#       stage 2 (ExecStartPost) readiness: bounded post-start verification
#                 of the RUNNING broker — the only stage that can honestly
#                 demand --require-verified. If the live boundary is not
#                 verified within ~30s, the unit fails.
#   - restrictive filesystem privileges (ProtectSystem=strict, PrivateTmp,
#     PrivateDevices, NoNewPrivileges, ReadWritePaths limited to the two
#     SeqPass installation directories)
#   - NO credential-bearing environment variables: the broker resolves
#     credentials through its AegisKeys binding at operation time.
#     /etc/default/seqpass holds path/UID/group configuration only.
#
# Site-specific topology lives in /etc/default/seqpass (see the required
# keys below). A missing or empty key makes the stage-1 preflight fail, so
# the broker never starts with a silently narrowed identity set. Override
# individual settings with a systemd drop-in, not by editing this file.
#
# After editing /etc/default/seqpass or the unit: systemctl daemon-reload
# and systemctl restart seqpass-broker.

[Unit]
Description=SeqPass credential broker
Documentation=file:///usr/share/doc/seqpass/README.md
After=network-online.target
Wants=network-online.target
# Restart-window directives belong in [Unit]: in [Service] systemd ignores
# them (systemd-analyze verify flags the placement).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=seqpass
Group=seqpass
# REQUIRED (no "-" prefix: a missing file fails the unit). Keys (paths,
# UIDs, groups — NEVER credentials):
#   SEQPASS_DB                 broker SQLite path        (/var/lib/seqpass/broker.db)
#   SEQPASS_SOCKET             agent socket              (/run/seqpass-agent/broker.sock)
#   SEQPASS_ADMIN_SOCKET       admin socket              (/run/seqpass/admin.sock)
#   SEQPASS_INTAKE_SOCKET      trusted intake socket     (/run/seqpass/intake.sock)
#   SEQPASS_AGENT_UIDS         approved agent UIDs       (comma-separated; must exclude the broker euid)
#   SEQPASS_ADMIN_UIDS         admin UIDs                (comma-separated)
#   SEQPASS_INTAKE_UIDS        trusted intake UIDs       (comma-separated; must exclude agent UIDs)
#   SEQPASS_SOCKET_GROUP       agent socket group        (own the agent socket+dir)
#   SEQPASS_INTAKE_GROUP       trusted intake group      (must differ from the agent group)
#   SEQPASS_AEGISKEYS_SOCKET   AegisKeys broker socket   (HTTP-over-Unix, never TCP)
#   SEQPASS_RESOLVE_HELPER     trusted resolve helper    (usually /usr/local/bin/seqpass)
#                              P0-1: AegisKeys authenticates peers by reading
#                              /proc/<pid>/exe, which the kernel refuses for
#                              this non-dumpable broker. Credential resolves
#                              therefore run through a short-lived helper
#                              process (dumpable, RLIMIT_CORE=0, spawned per
#                              approved resolve with a private inherited
#                              descriptor). Its executable identity is the
#                              AegisKeys grant target.
EnvironmentFile=/etc/default/seqpass

# Stage 1 — preflight (broker not running yet). Hardens the trusted
# runtime directory to owner-only FIRST: systemd creates both runtime
# directories with RuntimeDirectoryMode (0750 — the agent directory needs
# group traverse for the approved agent group); the admin/intake directory
# must be 0700 because the broker refuses a group-readable admin socket
# directory. The agent directory keeps 0750.
ExecStartPre=/bin/chmod 0700 /run/seqpass
ExecStartPre=/usr/local/bin/seqpass doctor --topology \
  --db ${SEQPASS_DB} \
  --socket ${SEQPASS_SOCKET} \
  --admin-socket ${SEQPASS_ADMIN_SOCKET} \
  --intake-socket ${SEQPASS_INTAKE_SOCKET} \
  --vault aegiskeys \
  --agent-uid ${SEQPASS_AGENT_UIDS} \
  --admin-uid ${SEQPASS_ADMIN_UIDS} \
  --intake-uid ${SEQPASS_INTAKE_UIDS} \
  --socket-group ${SEQPASS_SOCKET_GROUP} \
  --intake-group ${SEQPASS_INTAKE_GROUP} \
  --aegiskeys-socket ${SEQPASS_AEGISKEYS_SOCKET}

ExecStart=/usr/local/bin/seqpass broker \
  --vault aegiskeys \
  --db ${SEQPASS_DB} \
  --socket ${SEQPASS_SOCKET} \
  --admin-socket ${SEQPASS_ADMIN_SOCKET} \
  --intake-socket ${SEQPASS_INTAKE_SOCKET} \
  --agent-uid ${SEQPASS_AGENT_UIDS} \
  --admin-uid ${SEQPASS_ADMIN_UIDS} \
  --intake-uid ${SEQPASS_INTAKE_UIDS} \
  --socket-group ${SEQPASS_SOCKET_GROUP} \
  --intake-group ${SEQPASS_INTAKE_GROUP} \
  --aegiskeys-socket ${SEQPASS_AEGISKEYS_SOCKET} \
  --aegiskeys-resolve-helper ${SEQPASS_RESOLVE_HELPER} \
  --aegiskeys-attest-seed ${SEQPASS_ATTEST_SEED}

# Restart strategy (P0-1 attestation): without a provisioned seed the
# broker generates a FRESH attest key pair per start — secure, but the
# AegisKeys grant's attest_key pin then needs operator re-enrollment after
# every restart (rotation is surfaced via the audit log and
# admin.attest_public). For unattended durable reuse, provision a stable
# seed ONCE with systemd's encrypted-credential mechanism:
#
#   systemd-creds encrypt --name=seqpass_attest_seed \
#     < seed-32-bytes.bin /etc/seqpass/attest-seed.cred
#
# then drop-in:
#
#   [Service]
#   LoadCredentialEncrypted=seqpass_attest_seed:/etc/seqpass/attest-seed.cred
#   Environment=SEQPASS_ATTEST_SEED=%d/seqpass_attest_seed
#
# PID 1 decrypts the credential into the unit's read-only credential
# mount; it is never an ordinary file owned by the service UID, and the
# resolve helper inherits NONE of it (the helper's environment is an
# explicit allowlist that excludes CREDENTIALS_DIRECTORY). Generate the
# seed with, e.g.: `openssl rand 32 > seed-32-bytes.bin` on a trusted
# host. The credential file itself is root-only; the decrypted mount is
# visible only to this unit's processes.
#
# Without the drop-in SEQPASS_ATTEST_SEED is unset: systemd expands
# "${SEQPASS_ATTEST_SEED}" (braced form) to exactly one empty argument,
# which is the documented fresh-key default — never a missing flag
# argument. An operator using the unbraced "$SEQPASS_ATTEST_SEED" form
# gets a missing-argument failure instead (fail-closed).

# Stage 2 — readiness gate (bounded post-start verification). "$$" is the
# systemd escape for a literal "$": the retry state lives in the shell, not
# in systemd variable expansion. The gate queries the running broker's
# health and fails the unit unless the boundary reports verified.
ExecStartPost=/bin/sh -c 'i=0; while [ "$$i" -lt 60 ]; do if /usr/local/bin/seqpass doctor --require-verified --socket ${SEQPASS_SOCKET} >/dev/null 2>&1; then exit 0; fi; i=$$((i+1)); sleep 0.5; done; echo "seqpass-broker: readiness gate timed out: boundary never reported verified" >&2; exit 1'

Restart=on-failure
RestartSec=5s
TimeoutStopSec=15

# Restrictive filesystem / capability profile.
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not yes: the broker must still be able to connect(2) to the
# AegisKeys broker socket, whose default location is under the service
# user's home (~/.config/aegiskeys/run/broker.sock). read-only preserves
# the no-write boundary while permitting the socket dial. Deployments that
# run AegisKeys with its socket under /run can tighten this to "yes" via a
# drop-in.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# The only writable locations: runtime sockets and broker-owned state.
# systemd pre-creates both with the service identity.
#
# TWO runtime directories (P1 topology): the agent socket directory is
# separate from the admin/intake directory. The broker's isolated-assurance
# validation refuses an agent socket sharing a directory with admin/intake
# sockets, and the directory isolation is real: the agent directory
# (/run/seqpass-agent) is created 0750 and chowned to the agent socket
# group by the broker on start (0660 socket, group traverse via 0750's
# r-x), while /run/seqpass is tightened to 0700 by the first
# ExecStartPre — the 0600 admin/intake sockets inside it are unreachable
# to agents at the filesystem layer, not merely at the socket-mode layer.
# The service identity must be a member of the agent socket group so the
# broker can chown the agent directory to it (operator prerequisite:
# usermod -aG <agent-group> seqpass).
RuntimeDirectory=seqpass seqpass-agent
RuntimeDirectoryMode=0750
StateDirectory=seqpass
StateDirectoryMode=0700
ReadWritePaths=/run/seqpass /run/seqpass-agent /var/lib/seqpass
UMask=0077

[Install]
WantedBy=multi-user.target
